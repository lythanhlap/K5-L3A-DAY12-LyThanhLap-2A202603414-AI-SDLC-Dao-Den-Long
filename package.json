{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Đảo Đèn Lồng: 3D third-person lantern game (Three.js) with a deterministic headless mode",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "headless": "node src/headless.js",
    "test": "node --test \"tests/*.test.js\"",
    "proof": "node scripts/proof.mjs",
    "bench": "node scripts/bench.mjs --seed 42 --duration 30 --out docs/proof/phase-4/bench.json",
    "soak": "node --expose-gc scripts/soak.mjs --seed 7 --nights 10 --out docs/proof/phase-4/soak.json"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "puppeteer": "^25.18.1",
    "vite": "8.3.8"
  }
}
